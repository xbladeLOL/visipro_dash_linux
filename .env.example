DATABASE_URL=postgresql://visipro:visipro_local_password@localhost:5432/visipro?schema=public
# Generate a unique random secret before starting the dashboard.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PROSPECT_ENGINE_URL=http://127.0.0.1:8080
PROSPECT_ENGINE_API_KEY=replace_with_engine_api_key

# Email prospection: safety defaults, never a real send during development.
EMAIL_DELIVERY_MODE=simulation
EMAIL_REAL_SEND_ENABLED=false
# Generate separate random secrets (at least 32 characters); never commit real values.
EMAIL_IMPORT_API_KEY=
EMAIL_RECIPIENT_HASH_SECRET=
EMAIL_UNSUBSCRIBE_SECRET=
# Only needed for a separately authorized live configuration.
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_SENDER_IDENTITY=
EMAIL_PUBLIC_URL=https://dashboard.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
