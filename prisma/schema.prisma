generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProspectStage {
  NEW
  TO_ANALYZE
  TO_CONTACT
  CONTACTED
  TO_FOLLOW_UP
  REPLIED
  MEETING
  QUOTE_TO_PREPARE
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  INSTAGRAM
  MEETING
  NOTE
  FOLLOW_UP
}

enum ProjectStatus {
  TO_PREPARE
  WAITING_CLIENT
  IN_PROGRESS
  REVIEW
  READY_TO_DELIVER
  DELIVERED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REFUSED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  STRIPE
  CASH
  CHECK
  CARD
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CategoryKind {
  INCOME
  EXPENSE
  SERVICE
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum RecurringExpenseStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum PricingCatalogStatus {
  GLOBAL
  TEMPLATE
  CLIENT_SPECIFIC
  ARCHIVED
}

enum PricingPriceType {
  FIXED
  STARTING_AT
  FROM_TO
  ON_QUOTE
  CUSTOM_TEXT
}

enum PricingBillingType {
  ONE_TIME
  MONTHLY
  YEARLY
  CUSTOM
}

enum PricingDiscountType {
  NONE
  AMOUNT
  PERCENT
}

enum PricingPdfMode {
  COMPACT
  STANDARD
  DETAILED
}

enum DocumentType {
  CONTRACT
  QUOTE_PDF
  INVOICE
  RECEIPT
  PHOTO
  ADMINISTRATIVE
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(OWNER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CompanySettings {
  id                 String   @id @default(cuid())
  name               String   @default("VisiPro")
  legalName          String?
  address            String?
  siren              String?
  siret              String?
  vatNumber          String?
  email              String?
  phone              String?
  website            String?
  iban               String?
  logoUrl            String?
  currency           String   @default("EUR")
  defaultVatRate     Decimal  @default(20) @db.Decimal(5, 2)
  paymentTerms       String?
  quotePrefix        String   @default("DEV")
  invoicePrefix      String   @default("FAC")
  initialCashBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Prospect {
  id              String        @id @default(cuid())
  companyName     String
  contactName     String?
  email           String?
  phone           String?
  website         String?
  address         String?
  city            String?
  source          String?
  activity        String?
  notes           String?       @db.Text
  potentialValue  Decimal       @default(0) @db.Decimal(12, 2)
  stage           ProspectStage @default(NEW)
  nextAction      String?
  nextFollowUpAt  DateTime?
  convertedClient Client?
  activities      Activity[]
  quotes          Quote[]
  pricingCatalogs PricingCatalog[]
  documents       Document[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([stage])
  @@index([city])
}

model Client {
  id            String         @id @default(cuid())
  prospectId    String?        @unique
  legalName     String
  tradeName     String?
  address       String?
  siren         String?
  siret         String?
  vatNumber     String?
  contactName   String?
  email         String?
  phone         String?
  website       String?
  notes         String?        @db.Text
  prospect      Prospect?      @relation(fields: [prospectId], references: [id])
  contacts      Contact[]
  activities    Activity[]
  projects      Project[]
  tasks         Task[]
  quotes        Quote[]
  invoices      Invoice[]
  payments      Payment[]
  expenses      Expense[]
  transactions  Transaction[]
  subscriptions Subscription[]
  pricingCatalogs PricingCatalog[]
  documents     Document[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  content    String       @db.Text
  happenedAt DateTime     @default(now())
  prospectId String?
  clientId   String?
  projectId  String?
  prospect   Prospect?    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  client     Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
}

model Service {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  defaultVat  Decimal   @default(20) @db.Decimal(5, 2)
  projects    Project[]
  quoteItems  QuoteItem[]
  invoiceItems InvoiceItem[]
  subscriptions Subscription[]
}

model Project {
  id             String                 @id @default(cuid())
  name           String
  clientId       String
  serviceId      String?
  price          Decimal                @default(0) @db.Decimal(12, 2)
  status         ProjectStatus          @default(TO_PREPARE)
  priority       Priority               @default(MEDIUM)
  startDate      DateTime?
  deadline       DateTime?
  description    String?                @db.Text
  progress       Int                    @default(0)
  client         Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service        Service?               @relation(fields: [serviceId], references: [id])
  checklistItems ProjectChecklistItem[]
  tasks          Task[]
  activities     Activity[]
  documents      Document[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model ProjectChecklistItem {
  id          String  @id @default(cuid())
  projectId   String
  label       String
  isCompleted Boolean @default(false)
  position    Int     @default(0)
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  projectId   String?
  clientId    String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Quote {
  id        String      @id @default(cuid())
  number    String      @unique
  clientId  String?
  prospectId String?
  issuedAt  DateTime    @default(now())
  validUntil DateTime?
  subtotal  Decimal     @default(0) @db.Decimal(12, 2)
  tax       Decimal      @default(0) @db.Decimal(12, 2)
  total     Decimal      @default(0) @db.Decimal(12, 2)
  status    QuoteStatus  @default(DRAFT)
  terms     String?      @db.Text
  notes     String?      @db.Text
  client    Client?      @relation(fields: [clientId], references: [id])
  prospect  Prospect?    @relation(fields: [prospectId], references: [id])
  items     QuoteItem[]
  invoice   Invoice?
  documents Document[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  serviceId   String?
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(20) @db.Decimal(5, 2)
  discountRate Decimal @default(0) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  tax         Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service     Service? @relation(fields: [serviceId], references: [id])
}

model Invoice {
  id              String        @id @default(cuid())
  number          String        @unique
  clientId        String
  quoteId         String?       @unique
  issuedAt        DateTime      @default(now())
  dueDate         DateTime
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal       @default(0) @db.Decimal(12, 2)
  status          InvoiceStatus @default(DRAFT)
  terms           String?       @db.Text
  notes           String?       @db.Text
  client          Client        @relation(fields: [clientId], references: [id])
  quote           Quote?        @relation(fields: [quoteId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  transactions    Transaction[]
  documents       Document[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @default(20) @db.Decimal(5, 2)
  discountRate Decimal @default(0) @db.Decimal(5, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  tax         Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service     Service? @relation(fields: [serviceId], references: [id])
}

model Payment {
  id        String      @id @default(cuid())
  invoiceId String
  clientId  String
  amount    Decimal     @db.Decimal(12, 2)
  paidAt    DateTime
  method    String
  reference String?
  notes     String?     @db.Text
  invoice   Invoice     @relation(fields: [invoiceId], references: [id])
  client    Client      @relation(fields: [clientId], references: [id])
  transaction Transaction?
  createdAt DateTime    @default(now())
}

model Expense {
  id                 String       @id @default(cuid())
  date               DateTime
  vendor             String
  description        String
  categoryId         String?
  amountExcludingTax Decimal      @db.Decimal(12, 2)
  taxAmount          Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal      @db.Decimal(12, 2)
  paymentMethod      String
  receiptDocumentId  String?      @unique
  recurringExpenseId String?
  notes              String?      @db.Text
  clientId           String?
  category           Category?    @relation(fields: [categoryId], references: [id])
  client             Client?      @relation(fields: [clientId], references: [id])
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  receiptDocument    Document?    @relation("ExpenseReceipt", fields: [receiptDocumentId], references: [id])
  transaction        Transaction?
  documents          Document[]   @relation("ExpenseDocuments")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model RecurringExpense {
  id                 String                 @id @default(cuid())
  name               String
  vendor             String
  description        String
  categoryId         String?
  amountExcludingTax Decimal                @db.Decimal(12, 2)
  taxAmount          Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal                @db.Decimal(12, 2)
  paymentMethod      String
  startDate          DateTime
  endDate            DateTime?
  nextRunAt          DateTime
  status             RecurringExpenseStatus @default(ACTIVE)
  notes              String?                @db.Text
  category           Category?              @relation(fields: [categoryId], references: [id])
  expenses           Expense[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model Transaction {
  id            String          @id @default(cuid())
  type          TransactionType
  date          DateTime
  amount        Decimal         @db.Decimal(12, 2)
  categoryId    String?
  categoryLabel String?
  clientId      String?
  vendor        String?
  invoiceId     String?
  paymentId     String?         @unique
  expenseId     String?         @unique
  paymentMethod String?
  account       String?         @default("Compte principal")
  reference     String?
  notes         String?         @db.Text
  category      Category?       @relation(fields: [categoryId], references: [id])
  client        Client?         @relation(fields: [clientId], references: [id])
  invoice       Invoice?        @relation(fields: [invoiceId], references: [id])
  payment       Payment?        @relation(fields: [paymentId], references: [id])
  expense       Expense?        @relation(fields: [expenseId], references: [id])
  createdAt     DateTime        @default(now())
}

model Subscription {
  id          String               @id @default(cuid())
  clientId    String
  serviceId   String?
  name        String
  amount      Decimal              @db.Decimal(12, 2)
  interval    SubscriptionInterval @default(MONTHLY)
  startDate   DateTime
  endDate     DateTime?
  status      SubscriptionStatus   @default(ACTIVE)
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service     Service?             @relation(fields: [serviceId], references: [id])
  createdAt   DateTime             @default(now())
}

model PricingCatalog {
  id                 String               @id @default(cuid())
  name               String
  status             PricingCatalogStatus @default(GLOBAL)
  version            String               @default("2026")
  title              String               @default("GRILLE TARIFAIRE")
  subtitle           String               @default("Solutions digitales pour entreprises locales")
  introduction       String               @db.Text
  logoUrl            String?
  companyName        String               @default("VisiPro")
  phone              String?
  email              String?
  website            String?
  address            String?
  primaryColor       String               @default("#111827")
  secondaryColor     String               @default("#64748b")
  footerText         String?              @db.Text
  validUntil         DateTime?
  currency           String               @default("EUR")
  terms              String               @db.Text
  globalDiscountType PricingDiscountType  @default(NONE)
  globalDiscountValue Decimal             @default(0) @db.Decimal(12, 2)
  showOriginalPrices Boolean              @default(false)
  defaultPdfMode     PricingPdfMode       @default(STANDARD)
  showPricesOnPdf    Boolean              @default(true)
  showDescriptionsOnPdf Boolean           @default(true)
  showFeaturesOnPdf  Boolean              @default(true)
  showDeliveryTimeOnPdf Boolean           @default(true)
  showEstimatedTimeOnPdf Boolean          @default(false)
  showRevisionsOnPdf Boolean              @default(false)
  showRequirementsOnPdf Boolean           @default(false)
  showExclusionsOnPdf Boolean             @default(false)
  publicToken        String?              @unique
  sourceCatalogId    String?
  clientId           String?
  prospectId         String?
  client             Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  prospect           Prospect?            @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  sourceCatalog      PricingCatalog?      @relation("PricingCatalogVersions", fields: [sourceCatalogId], references: [id], onDelete: SetNull)
  derivedCatalogs    PricingCatalog[]     @relation("PricingCatalogVersions")
  categories         PricingCategory[]
  items              PricingItem[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([prospectId])
}

model PricingCategory {
  id           String         @id @default(cuid())
  catalogId    String
  name         String
  description  String?        @db.Text
  displayOrder Int            @default(0)
  isActive     Boolean        @default(true)
  catalog      PricingCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  items        PricingItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([catalogId, displayOrder])
}

model PricingItem {
  id                String               @id @default(cuid())
  catalogId         String
  categoryId        String
  name              String
  shortDescription  String?              @db.Text
  longDescription   String?              @db.Text
  basePrice         Decimal              @default(0) @db.Decimal(12, 2)
  minPrice          Decimal?             @db.Decimal(12, 2)
  maxPrice          Decimal?             @db.Decimal(12, 2)
  customPriceText   String?
  priceType         PricingPriceType     @default(STARTING_AT)
  billingType       PricingBillingType   @default(ONE_TIME)
  currency          String               @default("EUR")
  unit              String?
  taxRate           Decimal              @default(20) @db.Decimal(5, 2)
  features          Json                 @default("[]")
  isActive          Boolean              @default(true)
  isFeatured        Boolean              @default(false)
  showPrice         Boolean              @default(true)
  displayOrder      Int                  @default(0)
  internalCost      Decimal              @default(0) @db.Decimal(12, 2)
  estimatedHours    Decimal              @default(0) @db.Decimal(8, 2)
  estimatedHoursMin Decimal?             @db.Decimal(8, 2)
  estimatedHoursMax Decimal?             @db.Decimal(8, 2)
  estimatedDeliveryDaysMin Int?
  estimatedDeliveryDaysMax Int?
  revisionsIncluded Int?
  revisionPolicy    String?              @db.Text
  clientRequirements Json                @default("[]")
  deliverables      Json                 @default("[]")
  notIncluded       Json                 @default("[]")
  internalNotes     String?              @db.Text
  estimatedTimeDisclaimer String?        @db.Text
  deliveryTimeDisclaimer String?         @db.Text
  showEstimatedTimeOnPdf Boolean         @default(false)
  showDeliveryTimeOnPdf Boolean          @default(true)
  showDeliverablesOnPdf Boolean          @default(true)
  showRequirementsOnPdf Boolean          @default(false)
  showExclusionsOnPdf Boolean            @default(false)
  notes             String?              @db.Text
  discountType      PricingDiscountType  @default(NONE)
  discountValue     Decimal              @default(0) @db.Decimal(12, 2)
  showOriginalPrice Boolean              @default(false)
  isPack            Boolean              @default(false)
  showSavings       Boolean              @default(false)
  catalog           PricingCatalog       @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  category          PricingCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  packageItems      PricingPackageItem[] @relation("PricingPackage")
  includedInPacks   PricingPackageItem[] @relation("PricingPackageComponent")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([catalogId])
  @@index([categoryId, displayOrder])
}

model PricingPackageItem {
  id        String      @id @default(cuid())
  packId    String
  itemId    String
  quantity  Decimal     @default(1) @db.Decimal(10, 2)
  pack      PricingItem @relation("PricingPackage", fields: [packId], references: [id], onDelete: Cascade)
  item      PricingItem @relation("PricingPackageComponent", fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([packId, itemId])
}

model Document {
  id        String       @id @default(cuid())
  name      String
  type      DocumentType
  mimeType  String?
  size      Int?
  storageProvider String  @default("local-placeholder")
  storageKey String
  url       String?
  clientId  String?
  prospectId String?
  projectId String?
  quoteId   String?
  invoiceId String?
  expenseId String?
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  prospect  Prospect?    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quote     Quote?       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoice   Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  expense   Expense?     @relation("ExpenseDocuments", fields: [expenseId], references: [id], onDelete: Cascade)
  receiptForExpense Expense? @relation("ExpenseReceipt")
  createdAt DateTime     @default(now())
}

model Category {
  id           String        @id @default(cuid())
  name         String
  kind         CategoryKind
  defaultVat   Decimal?      @db.Decimal(5, 2)
  expenses     Expense[]
  recurringExpenses RecurringExpense[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())

  @@unique([name, kind])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
}
